load("//bazel/lint:golangci.bzl", "golangci_test")
load("//bazel/vuln:govulncheck.bzl", "govulncheck_test")

golangci_test(
    name = "lint",
    size = "small",
    flags = [
        "run",
        "./go/...",
    ],
    # go list needs modules; sandbox has GOPROXY=off and no cache.
    local = True,
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
)

govulncheck_test(
    name = "vuln",
    size = "small",
    flags = ["./go/..."],
    # Package load and vuln.go.dev need modules + network.
    local = True,
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
)
