load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("//:settings.bzl", "GO_BINARY_ARCHS", "PLATFORMS_PER_ARCH")

go_library(
    name = "client_lib",
    srcs = [
        "main.go",
        "retry.go",
    ],
    importpath = "github.com/amsokol/connect-examples/go/echo/cmd/client",
    visibility = ["//visibility:private"],
    deps = [
        "//go/api:apiv1",
        "@com_connectrpc_connect//:connect",
        "@org_golang_x_net//http2",
    ],
)

# Host / multiarch image transitions (same role as rust :client).
go_binary(
    name = "client",
    embed = [":client_lib"],
    visibility = ["//visibility:public"],
)

[
    go_cross_binary(
        name = "client_%s" % arch,
        platform = PLATFORMS_PER_ARCH[arch],
        target = ":client",
        visibility = ["//visibility:public"],
    )
    for arch in GO_BINARY_ARCHS
]

go_test(
    name = "client_test",
    size = "small",
    srcs = ["retry_test.go"],
    embed = [":client_lib"],
)
