load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library", "go_test")
load("//:settings.bzl", "GO_BINARY_ARCHS", "PLATFORMS_PER_ARCH")

go_library(
    name = "server_lib",
    srcs = [
        "log.go",
        "main.go",
    ],
    importpath = "github.com/amsokol/connect-examples/go/echo/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//go/api:apiv1",
        "@com_connectrpc_connect//:connect",
        "@com_connectrpc_grpchealth//:grpchealth",
        "@com_connectrpc_validate//:validate",
    ],
)

# Host / multiarch image transitions (same role as rust :client).
go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)

[
    go_cross_binary(
        name = "server_%s" % arch,
        platform = PLATFORMS_PER_ARCH[arch],
        target = ":server",
        visibility = ["//visibility:public"],
    )
    for arch in GO_BINARY_ARCHS
]

go_test(
    name = "server_test",
    size = "small",
    srcs = ["main_test.go"],
    embed = [":server_lib"],
)
