load("@npm//:defs.bzl", "npm_link_all_packages")
load("//constraints/amd64:defs.bzl", "AMD64_VARIANTS")
load("//constraints/arm64:defs.bzl", "ARM64_VARIANTS")

exports_files([
    "buf.gen.go.yaml",
    "buf.gen.python.yaml",
    "buf.gen.rust.yaml",
    "buf.yaml",
    "MODULE.bazel",
    "pnpm-lock.yaml",
    "pyproject.toml",
    "uv.lock",
])

npm_link_all_packages(name = "node_modules")

# Configuration setting for fastbuild mode.
config_setting(
    name = "fastbuild",
    values = {"compilation_mode": "fastbuild"},
)

# Configuration setting for debug mode.
config_setting(
    name = "debug",
    values = {"compilation_mode": "dbg"},
)

# Configuration setting for optimized mode.
config_setting(
    name = "optimized",
    values = {"compilation_mode": "opt"},
)

# x86-64 platforms

platform(
    name = "linux-x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    visibility = ["//visibility:public"],
)

[
    platform(
        name = "linux-x86_64-%s" % v,
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
            # Rustc microarch (see settings.bzl / -Ctarget-cpu).
            "//constraints/amd64:%s" % v,
            # rules_go GOAMD64 (v1/v2/v3/v4).
            "@rules_go//go/constraints/amd64:%s" % v,
        ],
        visibility = ["//visibility:public"],
    )
    for v in AMD64_VARIANTS
]

[
    config_setting(
        name = "amd64_%s" % v,
        constraint_values = ["//constraints/amd64:%s" % v],
    )
    for v in AMD64_VARIANTS
]

# AArch64 platforms

platform(
    name = "linux-aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
)

[
    platform(
        name = "linux-aarch64-%s" % v,
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:aarch64",
            "//constraints/arm64:%s" % v,
        ],
        visibility = ["//visibility:public"],
    )
    for v in ARM64_VARIANTS
]

[
    config_setting(
        name = "arm64_%s" % v,
        constraint_values = ["//constraints/arm64:%s" % v],
    )
    for v in ARM64_VARIANTS
]
