"""
Python dependencies for Bazel via aspect_rules_py + uv.

Single source of truth: repo-root pyproject.toml + uv.lock.
"""

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "pypi",
)
uv.project(
    default_build_dependencies = [
        "setuptools",
        "build",
        "wheel",
    ],
    hub_name = "pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, "pypi")
