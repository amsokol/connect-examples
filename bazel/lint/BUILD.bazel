load("@npm//:markdownlint-cli2/package_json.bzl", markdownlint_cli2_bin = "bin")
load("//bazel/lint:markdown.bzl", "markdownlint_test")
load("//bazel/lint:ruff.bzl", "ruff_binary")

package(default_visibility = ["//visibility:public"])

# Go linter from go.mod (gazelle-generated binary in go_deps).
alias(
    name = "golangci-lint",
    actual = "@com_github_golangci_golangci_lint_v2//cmd/golangci-lint:golangci-lint",
)

# Bazel formatter/linter from go.mod (gazelle-generated binary in go_deps).
alias(
    name = "buildifier",
    actual = "@com_github_bazelbuild_buildtools//buildifier:buildifier",
)

ruff_binary(
    name = "ruff",
    pkg = "@pypi//ruff",
)

markdownlint_cli2_bin.markdownlint_cli2_binary(
    name = "markdownlint-cli2",
)

markdownlint_test(
    name = "markdown",
    size = "small",
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
    ],
)
