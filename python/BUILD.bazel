load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel/lint:ruff.bzl", "ruff_test")

# Destination for //api/v1:generate → python/gen (directory sync).
exports_files(["gen"])

# Workspace-root imports so `python.gen...` / `python.echo...` resolve.
_IMPORTS = [".."]

py_library(
    name = "python_pkg",
    srcs = ["__init__.py"],
    imports = _IMPORTS,
    visibility = ["//visibility:public"],
)

py_library(
    name = "gen_py",
    srcs = glob(["gen/**/*.py"]),
    imports = _IMPORTS,
    visibility = ["//visibility:public"],
    deps = [
        ":python_pkg",
        "@pypi//connectrpc",
        "@pypi//protobuf_py",
    ],
)

# Hand-written sources only; python/gen is extend-exclude in pyproject.toml.
filegroup(
    name = "lint_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//visibility:public"],
)

_RUFF_SRCS = [
    ":lint_srcs",
    "//python/echo:lint_srcs",
    "//python/echo/client:lint_srcs",
]

ruff_test(
    name = "lint",
    size = "small",
    srcs = _RUFF_SRCS,
    args = [
        "check",
        "python",
    ],
    config = "//:pyproject.toml",
)

ruff_test(
    name = "format",
    size = "small",
    srcs = _RUFF_SRCS,
    args = [
        "format",
        "--check",
        "python",
    ],
    config = "//:pyproject.toml",
)
