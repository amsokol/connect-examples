load("@rules_rust//rust:defs.bzl", "rust_clippy_test")
load("//bazel/vuln:cargo_audit.bzl", "cargo_audit_test")

# First-party crates only. Per-arch binaries share the same sources as :client / :server.
# rust/buf/plugins is a Cargo lockfile pin, not a rust_* target.
rust_clippy_test(
    name = "lint",
    size = "small",
    targets = [
        "//rust/api",
        "//rust/echo/client",
        "//rust/echo/server",
    ],
)

cargo_audit_test(
    name = "vuln",
    size = "small",
    local = True,
    tags = [
        "external",
        "no-cache",
        "no-sandbox",
        "requires-network",
    ],
)
