load("@bazel_utils_rust//:rust.bzl", "cargo_audit_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test")

# First-party crates only. Per-arch binaries share the same sources as :client / :server.
rust_clippy_test(
    name = "lint",
    size = "small",
    targets = [
        "//rust/api",
        "//rust/echo/client",
        "//rust/echo/server",
    ],
)

cargo_audit_test(
    name = "vuln",
    size = "small",
)
